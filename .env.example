# Google Analytics 4 Configuration
# Get your measurement ID from: https://analytics.google.com/
# Go to Admin > Data Streams > Your Web Stream > Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Analytics backend (FastAPI on Render) — used by Dashboard3.tsx for
# the Custom Range route. Preset ranges are served from the daily Gist.
VITE_ANALYTICS_API_URL=https://portfolio-analytics-api.onrender.com

# Voice agent WebSocket (Aria, Deepgram-backed) — used by VoiceAgent.tsx.
# In production this MUST point at the Render service that hosts /agent
# (not at the portfolio domain — Netlify doesn't proxy WebSocket).
# Leave blank for local dev to fall back to ws://localhost:8100/agent
# (the standalone voice-agent/server.py).
VITE_VOICE_AGENT_WS_URL=wss://portfolio-analytics-api.onrender.com/agent
